{
  "expo": {
    "name": "FriendTime",
    "slug": "friend-time-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F7F2EA"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alexlazerat.friendtime",
      "infoPlist": {
        "NSLocationAlwaysAndWhenInUseUsageDescription": "FriendTime utilise votre localisation pour calculer le temps passé avec vos amis, même quand l'app est fermée.",
        "NSLocationWhenInUseUsageDescription": "FriendTime utilise votre localisation pour détecter quand vous êtes avec vos amis.",
        "NSLocationAlwaysUsageDescription": "FriendTime a besoin d'accéder à votre localisation en arrière-plan pour calculer automatiquement le temps passé avec vos amis.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F7F2EA"
      },
      "package": "com.alexlazerat.friendtime",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB8_gO4Ch4Jn3rX7hIy5DPc8EWR0widb10"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "FriendTime utilise votre localisation pour calculer le temps passé avec vos amis.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-font",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "70a8a83b-dc0b-4757-829c-536bb9dc4c9c"
      }
    },
    "owner": "alazerat"
  }
}
